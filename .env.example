# OBS Logic Block Dev Environment — copy to .env and adjust if needed.
# The defaults work out of the box for local development.

# MQTT service account (must be consistent across all three variables)
OBS_MQTT_USERNAME=obs
OBS_MQTT_PASSWORD=changeme

# JWT secret for the Admin UI session — change for anything beyond local dev
OBS_JWT_SECRET=dev-secret-change-in-production

# Log level: DEBUG | INFO | WARNING | ERROR
OBS_LOG_LEVEL=INFO

# Host port for the Admin UI (default: 8080)
# OBS_HTTP_HOST_PORT=8080
